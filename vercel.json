{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "api/spa.html"
    }
  },
  "redirects": [
    {
      "source": "/produtos/:slug/",
      "destination": "/produto/:slug",
      "permanent": true
    },
    {
      "source": "/produtos/:slug",
      "destination": "/produto/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/produto/:slug",
      "destination": "/api?nativaSeoProduct=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?nativaSeoSitemap=1"
    },
    {
      "source": "/categoria/:slug",
      "destination": "/api?nativaSeoCategory=:slug"
    },
    {
      "source": "/como-comprar",
      "destination": "/api?nativaSeoPage=como-comprar"
    },
    {
      "source": "/trocas-e-devolucoes",
      "destination": "/api?nativaSeoPage=trocas-e-devolucoes"
    },
    {
      "source": "/frete-e-entrega",
      "destination": "/api?nativaSeoPage=frete-e-entrega"
    },
    {
      "source": "/perguntas-frequentes",
      "destination": "/api?nativaSeoPage=perguntas-frequentes"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/produto/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=30, must-revalidate"
        },
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/categoria/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=30, must-revalidate"
        },
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/como-comprar",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, must-revalidate"
        },
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/trocas-e-devolucoes",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, must-revalidate"
        },
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/frete-e-entrega",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, must-revalidate"
        },
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/perguntas-frequentes",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, must-revalidate"
        },
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    }
  ]
}
